{
  "manifest_version": 3,
  "name": "YouTube Intent Gate",
  "version": "0.1.0",
  "description": "Choose your intention before opening YouTube Home.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "icons": {
    "16": "icons/doctor-doom-16.png",
    "32": "icons/doctor-doom-32.png",
    "48": "icons/doctor-doom-48.png",
    "128": "icons/doctor-doom-128.png"
  },
  "action": {
    "default_title": "Intent Gate",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "content/early.css"
      ],
      "js": [
        "content/route.js",
        "lib/storage.js",
        "content/feed-suppress.js",
        "content/watch-later-redirect.js",
        "content/gate.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/overlay.html",
        "content/overlay.css",
        "icons/doctor-doom-48.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
